{
    "extends": "expo/tsconfig.base",
    "compilerOptions": {
        "target": "ES2016",
        "lib": [
            "ES2016"
        ],
        "allowJs": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "noFallthroughCasesInSwitch": true,
        "module": "ESNext",
        "moduleResolution": "node",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "jsx": "react-jsx",
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "./*"
            ],
            "@/components/*": [
                "./components/*"
            ],
            "@/contexts/*": [
                "./contexts/*"
            ],
            "@/styles/*": [
                "./styles/*"
            ],
            "@/utils/*": [
                "./utils/*"
            ],
            "@/locales/*": [
                "./locales/*"
            ]
        }
    },
    "include": [
        "**/*.ts",
        "**/*.tsx",
        "**/*.js",
        "**/*.jsx"
    ],
    "exclude": [
        "node_modules",
        "dist",
        ".expo"
    ]
}