{
  "expo": {
    "name": "heyday",
    "slug": "heyday",
    "version": "2.1.0",
    "runtimeVersion": "52.0.0",
    "updates": {
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "url": ""
    },
    "orientation": "portrait",
    "icon": "./assets/images/screens/heyDayLogo.png",
    "newArchEnabled": true,
    "userInterfaceStyle": "light",
    "androidStatusBar": {
      "backgroundColor": "#ffffff",
      "barStyle": "light-content"
    },
    "extra": {
      "buildEnv": "dev",
      "buildVersion": "1.0.0-dev",
      "buildDate": "2024-12-23T10:42:02.611Z",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "" //Expo will generate this
      }
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.yonatan.heyday", ///bundleIdentifier
      "entitlements": {
        "aps-environment": "production"
      },
      "buildNumber": "1",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification",
          "remote-notification"
        ],
        "ExpoLocalization_supportsRTL": true,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/screens/heyDayLogo.png", 
        "backgroundColor": "#00FF84"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK"
      ],
      "package":"com.yonatan.heyday", //?
      "versionCode": 1,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": ""
            },
            {
              "scheme": "https",
              "host": ""
            },
            {
              "scheme": "https",
              "host": "",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "lang": "he",
      "config": {
        "sdkVersion": "53.0.0"
      },
      "bundler": "metro"
    },
    "scheme": "heyday",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/screens/heyDayLogo.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "imageWidth": 200,
          "imageHeight": 200,
          "duration": 1000,
          "fade": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0"
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ]
    ],
    "owner": "yonatanhershko"
  }
}